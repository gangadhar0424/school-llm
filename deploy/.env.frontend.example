# =====================================================================
# Next.js production env (KVM 2)
# =====================================================================
# Copy to `/opt/school-llm/frontend_next/.env.production` BEFORE running
# `npm run build`. These values are baked into the build output for
# anything that runs at build time; the Route Handlers re-read them at
# runtime, so updating values requires a rebuild + restart.
# =====================================================================

# FastAPI URL — same box, loopback. Nginx terminates TLS in front of
# both Next.js (3000) and FastAPI (8000).
BACKEND_URL=http://127.0.0.1:8000

# Mark cookies Secure (HTTPS only). Set to 1 in production. Leave unset
# in local dev where you're using plain http://localhost:3000.
COOKIE_SECURE=1

# Telemetry off — we don't need Next.js phoning home.
NEXT_TELEMETRY_DISABLED=1
