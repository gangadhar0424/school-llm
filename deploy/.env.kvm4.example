# =====================================================================
# KVM 4 (Ollama server) — env template
# =====================================================================
# This box runs ONLY Ollama. No FastAPI, no MongoDB, no Next.js.
# All 16 GB RAM + 4 vCPU go to the model.
#
# Put these in /etc/systemd/system/ollama.service.d/override.conf as
# `Environment=KEY=value` lines (see the deployment runbook).
# =====================================================================

# Bind Ollama to the PRIVATE network interface only — never to 0.0.0.0
# on the public internet. The 127.0.0.1 default is wrong for our setup
# (KVM 2 needs to reach it); use the box's internal IP.
OLLAMA_HOST=0.0.0.0:11434

# Limit how many models Ollama will keep loaded simultaneously. On a
# 16 GB box, 1 keeps the active model resident and avoids swap.
OLLAMA_MAX_LOADED_MODELS=1

# How long an idle model stays in RAM before unloading. Keep it loaded
# during school hours to avoid the 30-second reload on the next call.
OLLAMA_KEEP_ALIVE=2h

# CORS — only allow the KVM 2 box's internal IP. Replace with the real
# address (or the comma-separated list if you have multiple app boxes).
OLLAMA_ORIGINS=http://KVM2_PRIVATE_IP

# Concurrent requests Ollama will handle in parallel. On CPU-only
# inference this is best left at 1 — additional concurrency means each
# request gets less CPU and feels slower.
OLLAMA_NUM_PARALLEL=1

# Number of requests Ollama will queue up before rejecting. 4 is a
# sane default for 5–10 users.
OLLAMA_MAX_QUEUE=4
