# =====================================================================
# KVM 2 (app server) — .env template
# =====================================================================
# Copy to `/opt/school-llm/.env` on the KVM 2 box and fill in the
# values. Anything left as a placeholder will either crash startup
# (good — fail loud) or log a warning (read the warning, don't ignore).
# =====================================================================

# ── Server bind ──────────────────────────────────────────────────────
# Bind to 127.0.0.1 because Nginx will proxy 443 → 8000 on the same box.
HOST=127.0.0.1
PORT=8000

# Number of uvicorn workers. KVM 2 has 2 vCPU → set to 2.
UVICORN_WORKERS=2

# ── Auth ─────────────────────────────────────────────────────────────
# eSkoolia ERP is the identity provider for this deployment.
AUTH_PROVIDER=eskoolia
ESKOOLIA_BASE_URL=https://app.eskoolia.com
ESKOOLIA_ME_CACHE_TTL=60
ESKOOLIA_HTTP_TIMEOUT=10

# JWT signing — REQUIRED. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Treat this like a database password. Do NOT commit. Do NOT reuse
# across staging/production. Rotating it logs every user out.
JWT_SECRET_KEY=REPLACE_ME_WITH_48_CHARS_OF_RANDOM

# ── MongoDB ──────────────────────────────────────────────────────────
# Pick ONE:
#   A. Mongo Atlas (recommended — free M0 tier handles 5–10 users fine).
#   B. Self-hosted Mongo on the same KVM 2 box.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/school_llm?retryWrites=true&w=majority
# Or for self-hosted:
# MONGODB_URI=mongodb://localhost:27017/school_llm

# ── Ollama (running on the KVM 4 box) ────────────────────────────────
# Replace with the KVM 4 box's private IP or the internal hostname.
# Use the Hostinger private network if available so Ollama isn't on
# the public internet.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://KVM4_PRIVATE_IP:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=120

# ── Embeddings ───────────────────────────────────────────────────────
# Local sentence-transformers model is small enough to run alongside
# FastAPI on KVM 2.
EMBEDDINGS_PROVIDER=sentence_transformers
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── CORS — REQUIRED in production ────────────────────────────────────
# Comma-separated list of frontend origins. NO trailing slash. Wildcard
# (*) is silently swapped for localhost since it breaks cookie auth.
CORS_ORIGINS=https://llm.your-school.com,https://staging.llm.your-school.com

# ── Upload guards ────────────────────────────────────────────────────
# 50 MB is enough for one NCERT chapter PDF. Lower if you want to be
# more conservative.
MAX_PDF_UPLOAD_MB=50

# ── Audio (local TTS via pyttsx3) ────────────────────────────────────
# Requires `apt install espeak` on Linux. Leave AUDIO_VOICE empty to
# let the OS pick the default voice.
AUDIO_VOICE=
AUDIO_RATE=175

# ── Logging ──────────────────────────────────────────────────────────
RELOAD=false
